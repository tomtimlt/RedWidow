{
  "name": "@warband/vscode",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Extension VS Code de warband (ADR 0004).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./logic/*": {
      "types": "./dist/logic/*.d.ts",
      "default": "./dist/logic/*.js"
    },
    "./engine/*": {
      "types": "./dist/engine/*.d.ts",
      "default": "./dist/engine/*.js"
    }
  },
  "scripts": {
    "package": "node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@warband/agent-opencode": "workspace:*",
    "@warband/agent-sdk": "workspace:*",
    "@warband/core": "workspace:*",
    "@warband/messages": "workspace:*",
    "yazl": "2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "@types/yazl": "2.4.5",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "optionalDependencies": {
    "opencode-darwin-arm64": "1.19.0",
    "opencode-darwin-x64-baseline": "1.19.0",
    "opencode-linux-x64-baseline": "1.19.0",
    "opencode-windows-x64-baseline": "1.19.0"
  }
}
