{
  "name": "warband",
  "displayName": "Venator Ops",
  "description": "Espace de pentest pour VS Code : missions, terminaux, preuves et rapports, avec IA optionnelle.",
  "version": "0.3.66",
  "publisher": "warband",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Venator Ops exécute un agent qui lit et modifie les fichiers de l'espace de travail : il est désactivé tant que le dossier n'est pas approuvé."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "warband.listProjectEvidence",
        "title": "Venator Ops : Lister les preuves du projet"
      },
      {
        "command": "warband.captureEditorEvidence",
        "title": "Venator Ops : Capturer la sélection comme preuve"
      },
      {
        "command": "warband.captureTerminalEvidence",
        "title": "Venator Ops : Capturer un extrait du journal terminal"
      },
      {
        "command": "warband.missionContext",
        "title": "Venator Ops : Voir le contexte de cette mission"
      },
      {
        "command": "warband.exportKillchain",
        "title": "Venator Ops : Exporter la Kill Chain en image SVG"
      },
      {
        "command": "warband.exportReport",
        "title": "Venator Ops : Exporter un brouillon de rapport Markdown"
      },
      {
        "command": "warband.openWorkspace",
        "title": "Venator Ops : ouvrir ou restaurer l’espace Venator Ops"
      },
      {
        "command": "warband.prepareMission",
        "title": "Venator Ops : préparer et vérifier le dossier de mission"
      },
      {
        "command": "warband.chooseProfile",
        "title": "Venator Ops : choisir un skill / profil agent"
      },
      {
        "command": "warband.configureIntegrations",
        "title": "Venator Ops : catalogue des intégrations MCP"
      },
      {
        "command": "warband.launcher",
        "title": "Venator Ops : lanceur",
        "icon": "$(rocket)"
      },
      {
        "command": "warband.openChat",
        "title": "Venator Ops : ouvrir un chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "warband.openCockpit",
        "title": "Venator Ops : ouvrir le cockpit",
        "icon": "$(dashboard)"
      },
      {
        "command": "warband.openStudio",
        "title": "Venator Ops : ouvrir les réglages",
        "icon": "$(settings-gear)"
      },
      {
        "command": "warband.openTerminal",
        "title": "Venator Ops : ouvrir un terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "warband.openMonitor",
        "title": "Venator Ops : ouvrir le Monitor",
        "icon": "$(pulse)"
      },
      {
        "command": "warband.openKillchain",
        "title": "Venator Ops : ouvrir la Kill chain",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "warband.focusChat",
        "title": "Venator Ops : aller au chat latéral",
        "icon": "$(comment)"
      },
      {
        "command": "warband.setToken",
        "title": "Venator Ops : définir le jeton",
        "icon": "$(key)"
      },
      {
        "command": "warband.clearToken",
        "title": "Venator Ops : effacer le jeton"
      },
      {
        "command": "warband.diagnostic",
        "title": "Venator Ops : diagnostic",
        "icon": "$(pulse)"
      },
      {
        "command": "warband.configureBurp",
        "title": "Venator Ops : configurer Burp Suite MCP"
      },
      {
        "command": "warband.testBurp",
        "title": "Venator Ops : tester la connexion MCP Burp Suite"
      },
      {
        "command": "warband.choosePalette",
        "title": "Venator Ops : choisir une palette"
      },
      {
        "command": "warband.previewReport",
        "title": "Venator Ops : prévisualiser le brouillon de rapport"
      },
      {
        "command": "warband.exportAttackFlow",
        "title": "Venator Ops : exporter Attack Flow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warband.openTerminal",
          "when": "view == warband.chat",
          "group": "navigation@1"
        },
        {
          "command": "warband.openChat",
          "when": "view == warband.chat",
          "group": "navigation@2"
        },
        {
          "command": "warband.openMonitor",
          "when": "view == warband.chat",
          "group": "navigation@3"
        },
        {
          "command": "warband.openCockpit",
          "when": "view == warband.chat",
          "group": "navigation@4"
        },
        {
          "command": "warband.openKillchain",
          "when": "view == warband.chat",
          "group": "navigation@5"
        },
        {
          "command": "warband.openStudio",
          "when": "view == warband.chat",
          "group": "navigation@6"
        },
        {
          "command": "warband.launcher",
          "when": "view == warband.chat",
          "group": "navigation@7"
        }
      ],
      "editor/title": [
        {
          "command": "warband.openTerminal",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@1"
        },
        {
          "command": "warband.openChat",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@2"
        },
        {
          "command": "warband.openMonitor",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@3"
        },
        {
          "command": "warband.openCockpit",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@4"
        },
        {
          "command": "warband.openKillchain",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@5"
        },
        {
          "command": "warband.openStudio",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@6"
        },
        {
          "command": "warband.launcher",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@7"
        }
      ],
      "commandPalette": [
        {
          "command": "warband.focusChat",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "warband.launcher",
        "key": "alt+j alt+j",
        "mac": "ctrl+j ctrl+j"
      },
      {
        "command": "warband.focusChat",
        "key": "alt+j c",
        "mac": "ctrl+j c"
      },
      {
        "command": "warband.openChat",
        "key": "alt+j n",
        "mac": "ctrl+j n"
      },
      {
        "command": "warband.openTerminal",
        "key": "alt+j t",
        "mac": "ctrl+j t"
      },
      {
        "command": "warband.openCockpit",
        "key": "alt+j k",
        "mac": "ctrl+j k"
      },
      {
        "command": "warband.openMonitor",
        "key": "alt+j m",
        "mac": "ctrl+j m"
      },
      {
        "command": "warband.openKillchain",
        "key": "alt+j g",
        "mac": "ctrl+j g"
      },
      {
        "command": "warband.openStudio",
        "key": "alt+j s",
        "mac": "ctrl+j s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warband",
          "title": "Venator Ops",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "warband": [
        {
          "type": "webview",
          "id": "warband.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Venator Ops",
      "properties": {
        "warband.profile": {
          "type": "string",
          "enum": ["", "mentor", "bug-bounty", "out-of-box", "red-team", "htb"],
          "default": "",
          "scope": "machine",
          "description": "Profil méthodologique court, appliqué au prochain tour. Les sources sont chargées sur demande."
        },
        "warband.integrationsByProject": {
          "type": "object",
          "default": {},
          "maxProperties": 32,
          "scope": "machine",
          "description": "Services MCP locaux explicitement configurés. Ignoré dans le dépôt ; utiliser le catalogue Venator Ops."
        },
        "warband.burp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Expose le MCP Burp Suite local aux agents. Ignoré dans les réglages du dossier. Les tours suivants utilisent les nouveaux réglages."
        },
        "warband.burp.port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9876,
          "scope": "machine",
          "description": "Port du serveur MCP Burp sur 127.0.0.1. Aucun serveur distant ni commande Java lancé par Venator Ops."
        },
        "warband.burp.transport": {
          "type": "string",
          "enum": ["sse", "http"],
          "default": "sse",
          "scope": "machine",
          "enumDescriptions": ["SSE officiel sur /sse", "Streamable HTTP sur /mcp"],
          "description": "Transport du serveur MCP installé dans Burp Suite."
        },
        "warband.palette": {
          "type": "string",
          "enum": ["sentinelle", "braise", "spectre", "editeur", "multi"],
          "enumDescriptions": [
            "Sarcelle et ardoise",
            "Cramoisi et acier",
            "Violet et glace",
            "Accent du thème VS Code",
            "Six teintes réparties dans l’interface"
          ],
          "default": "sentinelle",
          "scope": "window",
          "description": "Palette visuelle de Venator Ops."
        },
        "warband.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Modèle à utiliser (texte libre). Vide : défaut du SDK. Ignoré s'il est posé au niveau de l'espace de travail."
        },
        "warband.maxTurns": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "Nombre maximal de tours de l'agent par conversation. 0 : pas de plafond."
        },
        "warband.ultracode.maxTurns": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "Plafond de tours du préréglage **Ultracode** (effort Max + limites longues). 0 : pas de plafond de tours. Remplace `warband.maxTurns` quand Ultracode est choisi."
        },
        "warband.ultracode.maxBudgetUsd": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "Plafond de dépense (USD) du préréglage **Ultracode**. 0 : pas de plafond de dépense."
        }
      }
    }
  }
}
