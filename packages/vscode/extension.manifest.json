{
  "name": "warband",
  "displayName": "RedWidow",
  "description": "%extension.description%",
  "version": "0.3.75",
  "publisher": "warband",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%extension.untrustedWorkspaces%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "warband.openAudit",
        "title": "%command.openAudit%"
      },
      {
        "command": "warband.exportAudit",
        "title": "%command.exportAudit%"
      },
      {
        "command": "warband.listProjectEvidence",
        "title": "%command.listProjectEvidence%"
      },
      {
        "command": "warband.captureEditorEvidence",
        "title": "%command.captureEditorEvidence%"
      },
      {
        "command": "warband.captureTerminalEvidence",
        "title": "%command.captureTerminalEvidence%"
      },
      {
        "command": "warband.missionContext",
        "title": "%command.missionContext%"
      },
      {
        "command": "warband.exportKillchain",
        "title": "%command.exportKillchain%"
      },
      {
        "command": "warband.exportReport",
        "title": "%command.exportReport%"
      },
      {
        "command": "warband.openWorkspace",
        "title": "%command.openWorkspace%"
      },
      {
        "command": "warband.prepareMission",
        "title": "%command.prepareMission%"
      },
      {
        "command": "warband.chooseProfile",
        "title": "%command.chooseProfile%"
      },
      {
        "command": "warband.configureIntegrations",
        "title": "%command.configureIntegrations%"
      },
      {
        "command": "warband.launcher",
        "title": "%command.launcher%",
        "icon": "$(rocket)"
      },
      {
        "command": "warband.openChat",
        "title": "%command.openChat%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "warband.openCockpit",
        "title": "%command.openCockpit%",
        "icon": "$(dashboard)"
      },
      {
        "command": "warband.openProgram",
        "title": "%command.openProgram%",
        "icon": "$(checklist)"
      },
      {
        "command": "warband.openSessions",
        "title": "%command.openSessions%",
        "icon": "$(layout)"
      },
      {
        "command": "warband.openStudio",
        "title": "%command.openStudio%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "warband.openTerminal",
        "title": "%command.openTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "warband.openMonitor",
        "title": "%command.openMonitor%",
        "icon": "$(pulse)"
      },
      {
        "command": "warband.openKillchain",
        "title": "%command.openKillchain%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "warband.focusChat",
        "title": "%command.focusChat%",
        "icon": "$(comment)"
      },
      {
        "command": "warband.setToken",
        "title": "%command.setToken%",
        "icon": "$(key)"
      },
      {
        "command": "warband.clearToken",
        "title": "%command.clearToken%"
      },
      {
        "command": "warband.diagnostic",
        "title": "%command.diagnostic%",
        "icon": "$(pulse)"
      },
      {
        "command": "warband.configureBurp",
        "title": "%command.configureBurp%"
      },
      {
        "command": "warband.testBurp",
        "title": "%command.testBurp%"
      },
      {
        "command": "warband.choosePalette",
        "title": "%command.choosePalette%"
      },
      {
        "command": "warband.previewReport",
        "title": "%command.previewReport%"
      },
      {
        "command": "warband.exportAttackFlow",
        "title": "%command.exportAttackFlow%"
      },
      {
        "command": "warband.configureProvider",
        "title": "%command.configureProvider%"
      },
      {
        "command": "warband.disableBypass",
        "title": "%command.disableBypass%"
      },
      {
        "command": "warband.revealPendingApproval",
        "title": "%command.revealPendingApproval%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warband.openStudio",
          "when": "view == warband.chat",
          "group": "navigation@1"
        },
        {
          "command": "warband.openProgram",
          "when": "view == warband.chat",
          "group": "navigation@2"
        },
        {
          "command": "warband.openCockpit",
          "when": "view == warband.chat",
          "group": "navigation@3"
        },
        {
          "command": "warband.openTerminal",
          "when": "view == warband.chat",
          "group": "navigation@4"
        },
        {
          "command": "warband.openKillchain",
          "when": "view == warband.chat",
          "group": "navigation@5"
        },
        {
          "command": "warband.openChat",
          "when": "view == warband.chat",
          "group": "1_more@1"
        },
        {
          "command": "warband.openMonitor",
          "when": "view == warband.chat",
          "group": "1_more@2"
        },
        {
          "command": "warband.openSessions",
          "when": "view == warband.chat",
          "group": "1_more@3"
        },
        {
          "command": "warband.launcher",
          "when": "view == warband.chat",
          "group": "1_more@4"
        }
      ],
      "editor/title": [
        {
          "command": "warband.openStudio",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@1"
        },
        {
          "command": "warband.openProgram",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@2"
        },
        {
          "command": "warband.openCockpit",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@3"
        },
        {
          "command": "warband.openTerminal",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@4"
        },
        {
          "command": "warband.openKillchain",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "navigation@5"
        },
        {
          "command": "warband.openChat",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "1_more@1"
        },
        {
          "command": "warband.openMonitor",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "1_more@2"
        },
        {
          "command": "warband.openSessions",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "1_more@3"
        },
        {
          "command": "warband.launcher",
          "when": "activeWebviewPanelId =~ /^warband\\./",
          "group": "1_more@4"
        }
      ],
      "commandPalette": [
        {
          "command": "warband.openAudit",
          "when": "false"
        },
        {
          "command": "warband.exportAudit",
          "when": "false"
        },
        {
          "command": "warband.listProjectEvidence",
          "when": "false"
        },
        {
          "command": "warband.exportKillchain",
          "when": "false"
        },
        {
          "command": "warband.exportReport",
          "when": "false"
        },
        {
          "command": "warband.openWorkspace",
          "when": "false"
        },
        {
          "command": "warband.prepareMission",
          "when": "false"
        },
        {
          "command": "warband.chooseProfile",
          "when": "false"
        },
        {
          "command": "warband.configureIntegrations",
          "when": "false"
        },
        {
          "command": "warband.openTerminal",
          "when": "false"
        },
        {
          "command": "warband.openMonitor",
          "when": "false"
        },
        {
          "command": "warband.openKillchain",
          "when": "false"
        },
        {
          "command": "warband.focusChat",
          "when": "false"
        },
        {
          "command": "warband.configureBurp",
          "when": "false"
        },
        {
          "command": "warband.testBurp",
          "when": "false"
        },
        {
          "command": "warband.choosePalette",
          "when": "false"
        },
        {
          "command": "warband.previewReport",
          "when": "false"
        },
        {
          "command": "warband.exportAttackFlow",
          "when": "false"
        },
        {
          "command": "warband.configureProvider",
          "when": "false"
        },
        {
          "command": "warband.disableBypass",
          "when": "warband.bypassActive"
        },
        {
          "command": "warband.revealPendingApproval",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "warband.launcher",
        "key": "alt+j alt+j",
        "mac": "ctrl+j ctrl+j"
      },
      {
        "command": "warband.focusChat",
        "key": "alt+j c",
        "mac": "ctrl+j c"
      },
      {
        "command": "warband.openChat",
        "key": "alt+j n",
        "mac": "ctrl+j n"
      },
      {
        "command": "warband.openTerminal",
        "key": "alt+j t",
        "mac": "ctrl+j t"
      },
      {
        "command": "warband.openCockpit",
        "key": "alt+j k",
        "mac": "ctrl+j k"
      },
      {
        "command": "warband.openMonitor",
        "key": "alt+j m",
        "mac": "ctrl+j m"
      },
      {
        "command": "warband.openKillchain",
        "key": "alt+j g",
        "mac": "ctrl+j g"
      },
      {
        "command": "warband.openStudio",
        "key": "alt+j s",
        "mac": "ctrl+j s"
      },
      {
        "command": "warband.openSessions",
        "key": "alt+j e",
        "mac": "ctrl+j e"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warband",
          "title": "RedWidow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "warband": [
        {
          "type": "webview",
          "id": "warband.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "RedWidow",
      "properties": {
        "warband.opencodeProviders": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "description": "%config.opencodeProviders%"
        },
        "warband.profile": {
          "type": "string",
          "enum": ["", "mentor", "bug-bounty", "out-of-box", "red-team", "htb"],
          "default": "",
          "scope": "machine",
          "description": "%config.profile%"
        },
        "warband.integrationsByProject": {
          "type": "object",
          "default": {},
          "maxProperties": 32,
          "scope": "machine",
          "description": "%config.integrationsByProject%"
        },
        "warband.burp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%config.burp.enabled%"
        },
        "warband.burp.port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9876,
          "scope": "machine",
          "description": "%config.burp.port%"
        },
        "warband.burp.transport": {
          "type": "string",
          "enum": ["sse", "http"],
          "default": "sse",
          "scope": "machine",
          "enumDescriptions": ["%config.burp.transport.enum.0%", "%config.burp.transport.enum.1%"],
          "description": "%config.burp.transport%"
        },
        "warband.terminalPrompt": {
          "type": "string",
          "enum": ["native", "redwidow", "compact", "minimal"],
          "default": "native",
          "scope": "machine",
          "description": "%config.terminalPrompt%",
          "enumDescriptions": [
            "%config.terminalPrompt.enum.0%",
            "%config.terminalPrompt.enum.1%",
            "%config.terminalPrompt.enum.2%",
            "%config.terminalPrompt.enum.3%"
          ]
        },
        "warband.palette": {
          "type": "string",
          "enum": [
            "widow",
            "sentinelle",
            "braise",
            "venom",
            "arctic",
            "spectre",
            "ultraviolet",
            "tactical",
            "rouge",
            "orange",
            "jaune",
            "vert",
            "bleu",
            "rose",
            "blanc",
            "aurora",
            "synthwave",
            "toxic",
            "bloodmoon",
            "ocean",
            "nebula",
            "multi",
            "editeur"
          ],
          "enumDescriptions": [
            "%config.palette.enum.0%",
            "%config.palette.enum.1%",
            "%config.palette.enum.2%",
            "%config.palette.enum.3%",
            "%config.palette.enum.4%",
            "%config.palette.enum.5%",
            "%config.palette.enum.6%",
            "%config.palette.enum.7%",
            "%config.palette.enum.8%",
            "%config.palette.enum.9%",
            "%config.palette.enum.10%",
            "%config.palette.enum.11%",
            "%config.palette.enum.12%",
            "%config.palette.enum.13%",
            "%config.palette.enum.14%",
            "%config.palette.enum.15%",
            "%config.palette.enum.16%",
            "%config.palette.enum.17%",
            "%config.palette.enum.18%",
            "%config.palette.enum.19%",
            "%config.palette.enum.20%",
            "%config.palette.enum.21%",
            "%config.palette.enum.22%"
          ],
          "default": "widow",
          "scope": "window",
          "description": "%config.palette%"
        },
        "warband.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.model%"
        },
        "warband.maxTurns": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "%config.maxTurns%"
        },
        "warband.ultracode.maxTurns": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "%config.ultracode.maxTurns%"
        },
        "warband.ultracode.maxBudgetUsd": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "scope": "machine",
          "markdownDescription": "%config.ultracode.maxBudgetUsd%"
        },
        "warband.language": {
          "type": "string",
          "enum": ["fr", "en"],
          "enumDescriptions": ["%config.language.enum.0%", "%config.language.enum.1%"],
          "default": "en",
          "scope": "application",
          "description": "%config.language%"
        },
        "warband.chat.providers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": ["claude", "openai", "opencode"],
          "scope": "machine",
          "description": "%config.chat.providers%"
        },
        "warband.chat.skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": ["mentor", "bug-bounty", "out-of-box", "red-team", "htb"],
          "scope": "machine",
          "description": "%config.chat.skills%"
        },
        "warband.chat.integrations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "scope": "machine",
          "description": "%config.chat.integrations%"
        },
        "warband.chat.webSearch": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "%config.chat.webSearch%"
        }
      }
    }
  },
  "icon": "media/redwidow-icon.png"
}
