{
  "name": "@warband/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Hôte web de RedWidow (ADR 0052).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "vendor:xterm": "node scripts/vendor-xterm.mjs",
    "vendor:codemirror": "node scripts/vendor-codemirror.mjs"
  },
  "bin": {
    "redwidow-server": "./dist/main.js"
