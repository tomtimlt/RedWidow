{
  "name": "warband-ui-design",
  "displayName": "Venator Ops · Design",
  "description": "Atelier de design VS Code avec chat, activités, graphe et données de démonstration.",
  "version": "0.0.1",
  "publisher": "warband",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "main": "./extension.cjs",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node test/demo.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onView:warbandDesign.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "warbandDesign.chat",
        "title": "Venator Ops : ouvrir le chat"
      },
      {
        "command": "warbandDesign.graph",
        "title": "Venator Ops : ouvrir le graphe"
      },
      {
        "command": "warbandDesign.monitor",
        "title": "Venator Ops : ouvrir le Monitor"
      },
      {
        "command": "warbandDesign.settings",
        "title": "Venator Ops : ouvrir les réglages"
      },
      {
        "command": "warbandDesign.scenario",
        "title": "Venator Ops : choisir un scénario"
      },
      {
        "command": "warbandDesign.palette",
        "title": "Venator Ops : choisir une palette"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warbandDesign",
          "title": "Venator Ops",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "warbandDesign": [
        {
          "type": "webview",
          "id": "warbandDesign.chat",
          "name": "Chat · Démonstration"
        }
      ]
    },
    "configuration": {
      "title": "Venator Ops",
      "properties": {
        "warbandDesign.palette": {
          "type": "string",
          "default": "sentinelle",
          "enum": [
            "sentinelle",
            "widow",
            "braise",
            "venom",
            "arctic",
            "spectre",
            "ultraviolet",
            "tactical",
            "rouge",
            "orange",
            "jaune",
            "vert",
            "bleu",
            "rose",
            "blanc",
            "aurora",
            "synthwave",
            "toxic",
            "bloodmoon",
            "ocean",
            "nebula",
            "multi",
            "editeur"
          ],
          "enumDescriptions": [
            "Sarcelle et ardoise : veille, terminal, sécurité",
            "Noir profond et cramoisi : la marque RedWidow",
            "Cramoisi et acier : la marque d'origine, plus offensive",
            "Vert toxique sur acier : terminal, offensif",
            "Bleu glacier : froid, net, défensif",
            "Violet et glace : agents, recherche, nuit",
            "Violet électrique : nuit, IA, laboratoire",
            "Olive et kaki : terrain, opérations",
            "Rouge franc",
            "Orange vif ; proche de la couleur des alertes",
            "Jaune soleil ; proche de la couleur des alertes",
            "Vert franc",
            "Bleu franc",
            "Rose vif",
            "Blanc pur, graphite en thème clair",
            "Dégradé cyan, bleu et violet",
            "Dégradé rose, violet et bleu",
            "Dégradé lime, vert et cyan",
            "Dégradé cramoisi, magenta et violet",
            "Dégradé sarcelle, bleu et indigo",
            "Dégradé rose, violet et cyan",
            "Six teintes, une par rôle : corail, vert, cyan, bleu, violet et rose",
            "Accent du thème VS Code : intégration maximale"
          ],
          "description": "Jeu de couleurs de Venator Ops (aussi réglable dans Réglages › Apparence). Les couleurs s'adaptent aux thèmes clair, sombre et contraste élevé."
        }
      }
    }
  }
}
